# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string. The database needs the PostGIS extension available (Phase 2's
# first migration runs CREATE EXTENSION postgis; Aiven and most managed hosts allow it).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/climate_platform
DATABASE_SSL=false
# Optional path to the server's CA certificate (PEM), for hosts with a private CA such as Aiven
# (console > service > Overview > CA certificate). SSL params in DATABASE_URL are ignored.
DATABASE_SSL_CA=

# Firebase project whose ID tokens this API accepts (Firebase console > Project settings > Project ID).
# Verifying ID tokens only needs the project ID; no service-account key is required for Phase 1.
FIREBASE_PROJECT_ID=your-firebase-project-id

# The very first Administrator (the one account the UI can't create). When this email signs in
# with a VERIFIED Firebase email and the platform has no administrator yet, its account becomes
# administrator. Does nothing once an administrator exists. Leave empty to turn it off.
BOOTSTRAP_ADMIN_EMAIL=

# Comma-separated browser origins allowed to call the API. Empty = no CORS headers are sent.
CORS_ORIGINS=http://localhost:5173

# Cloudinary stores flood-report photos, voice notes, videos and documents. Paste the "API environment
# variable" from the Cloudinary dashboard (Settings > API Keys) as-is. Leave empty to keep photos and
# voice notes in the database (videos and documents are then refused).
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>


# Where the web app lives: links in emails and push notifications point here.
APP_URL=http://localhost:5173

# ── Email (optional) — see docs/email.md ────────────────────────────────
# smtp (Nodemailer) | apps_script (Google Apps Script web app) | none
EMAIL_PROVIDER=none
# true: when the chosen provider fails, try the other one if it is configured
EMAIL_FALLBACK=true
EMAIL_FROM_NAME=GeoClime Intelligence
EMAIL_REPLY_TO=
# Emails sent per worker tick (every 10 seconds), so a big alert never hits a provider's limits at once
EMAIL_MAX_PER_TICK=30
# Nodemailer / SMTP (for Gmail use an app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
# Apps Script web app URL ending in /exec, and the optional shared token it checks
EMAIL_APPS_SCRIPT_URL=
EMAIL_APPS_SCRIPT_TOKEN=

# ── Push notifications (optional) — see docs/notifications.md ──────────
# Firebase console > Project settings > Service accounts > "Generate new private key": paste the
# whole JSON on one line, or base64-encode it. Empty: push notifications are off.
FIREBASE_SERVICE_ACCOUNT=

# Proxies in front of the API, so the public routes' rate limit sees each visitor's IP.
# 0 locally; 1 on Render (render.yaml sets it).
TRUST_PROXY_HOPS=0

# Import upload limits: max upload size (MB), max unpacked zip size (MB), and max rows/features per file.
IMPORT_MAX_FILE_MB=60
IMPORT_MAX_UNZIPPED_MB=200
IMPORT_MAX_ROWS=100000
# Largest single GeoPackage unpacked from an OpenStreetMap extract (MB). Streamed, one file at a time.
IMPORT_MAX_GPKG_MB=200
