# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL connection string. The database needs the PostGIS extension available (Phase 2's
# first migration runs CREATE EXTENSION postgis; Aiven and most managed hosts allow it).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/climate_platform
DATABASE_SSL=false
# Optional path to the server's CA certificate (PEM), for hosts with a private CA such as Aiven
# (console > service > Overview > CA certificate). SSL params in DATABASE_URL are ignored.
DATABASE_SSL_CA=

# Firebase project whose ID tokens this API accepts (Firebase console > Project settings > Project ID).
# Verifying ID tokens only needs the project ID; no service-account key is required for Phase 1.
FIREBASE_PROJECT_ID=your-firebase-project-id

# The very first Administrator (the one account the UI can't create). When this email signs in
# with a VERIFIED Firebase email and the platform has no administrator yet, its account becomes
# administrator. Does nothing once an administrator exists. Leave empty to turn it off.
BOOTSTRAP_ADMIN_EMAIL=

# Comma-separated browser origins allowed to call the API. Empty = no CORS headers are sent.
CORS_ORIGINS=http://localhost:5173
