{
  "info": {
    "name": "Climate Platform API",
    "description": "Climate Intelligence & Disaster Management Platform backend. Phase 1: Foundation & Authentication.\n\nRun **Auth > Firebase: sign in** first; its post-response script stores the Firebase ID token in `{{accessToken}}`, which every API request sends as a Bearer token. No request contains a hardcoded token.\n\nExample responses were captured by running each request against the real Express app with the database and Firebase replaced by in-memory fakes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
