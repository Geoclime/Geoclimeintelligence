# Copy to .env and fill in. Never commit .env.
# Everything prefixed VITE_ is compiled into the browser bundle, so it is PUBLIC.
# Never put a secret here (no service-account keys, no database URLs).

# The backend API's origin, without a trailing slash and without /api/v1.
VITE_API_URL=http://localhost:4000

# Firebase console > Project settings > General > Your apps > Web app config.
# The web API key identifies the project; it is not a secret, but it lives here so each
# environment (local, staging, production) can point at its own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
