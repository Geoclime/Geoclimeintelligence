# Loaded only by `vite --mode e2e` (npm run dev:e2e), which Cypress drives.
# In this mode the app uses an in-memory fake identity provider instead of Firebase, and every
# API call is stubbed by cy.intercept(), so nothing here points at a real service.
VITE_API_URL=http://localhost:4999
# Any pk.* string: Cypress stubs every api.mapbox.com request, so this never reaches Mapbox.
VITE_MAPBOX_TOKEN=pk.e2e-offline-token
